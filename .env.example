# ENTSO-E Transparency Platform API key. Optional: without it, ingestion uses
# SMARD (no key needed).
ENTSOE_API_KEY=

# Anthropic API key for the dashboard's "Ask about the forecast" chat feature.
# Optional — the rest of the app (forecasting, SHAP, dashboard) works without it;
# the /chat endpoint returns 503 until this is set.
ANTHROPIC_API_KEY=

# Shared secret required as the X-API-Key header on /chat (which spends Anthropic
# credits). The frontend sends it automatically. REQUIRED for chat whenever
# ANTHROPIC_API_KEY is set — chat stays disabled without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Comma-separated browser origins allowed by CORS (default: http://localhost:8501).
CORS_ORIGINS=http://localhost:8501
